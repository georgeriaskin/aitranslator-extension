{
  "manifest_version": 3,
  "name": "Aitranlator",
  "version": "1.0",
  "description": "A simple translation tool as Chrome extension",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aitranlator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://*.vercel.app/*",
    "http://localhost:3000/*",
    "https://aitranslator-qy7i3d4d6-kudapolet-gmailcoms-projects.vercel.app/*"
  ]
}